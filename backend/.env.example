# Copy to .env and fill in. NEVER commit the real .env file.
# For GitHub Actions, add each of these as a repository secret instead.

# --- Strava (shared app credentials; create at https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# One refresh token per Strava person (see strava_setup.py to generate)
STRAVA_REFRESH_TOKEN_JIAREN=

# --- Final Surge (per person who uses a training plan) ---
FINALSURGE_EMAIL_RUBY=
FINALSURGE_PASSWORD_RUBY=
