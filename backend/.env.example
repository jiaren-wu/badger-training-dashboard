# Copy to .env and fill in. NEVER commit the real .env file.
# For GitHub Actions, add each of these as a repository secret instead.

# --- Garmin Connect: ACTUAL mileage, one account per person -----------------
# Preferred: a base64 token blob from `python garmin_setup.py` (no MFA in CI).
# Run garmin_setup.py once while logged in as each person.
GARMIN_TOKENS_BASE64_RUBY=
GARMIN_TOKENS_BASE64_JIAREN=
# Fallback (local runs only; may prompt MFA): plain account login per person.
GARMIN_EMAIL_RUBY=
GARMIN_PASSWORD_RUBY=
GARMIN_EMAIL_JIAREN=
GARMIN_PASSWORD_JIAREN=

# --- Final Surge: PLANNED weekly mileage, one account per person ------------
# Optional. If a person has no Final Surge account (or a week has no planned
# distance) the build falls back to 26.2 miles for that week.
FINALSURGE_EMAIL_RUBY=
FINALSURGE_PASSWORD_RUBY=
FINALSURGE_EMAIL_JIAREN=
FINALSURGE_PASSWORD_JIAREN=
