# Copy to .env and fill in. NEVER commit the real .env file.
# For GitHub Actions, add each of these as a repository secret instead.

# --- Strava (optional; only if a person uses source "strava") ---
# Strava's API is free for personal use, but if you'd rather use Garmin, skip this.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# One refresh token per Strava person (see strava_setup.py to generate)
STRAVA_REFRESH_TOKEN_JIAREN=

# --- Garmin Connect (for people with source "garmin") ---
# Preferred: a base64 token blob from `python garmin_setup.py` (no MFA in CI).
GARMIN_TOKENS_BASE64=
# Fallback (local runs only; may prompt MFA): plain account login.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Final Surge (per person who uses a training plan) ---
FINALSURGE_EMAIL_RUBY=
FINALSURGE_PASSWORD_RUBY=
